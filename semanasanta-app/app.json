{
  "expo": {
    "name": "semanasanta-app",
    "slug": "semanasanta-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.elenaaaamavaz.semanasantaapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para seleccionar automáticamente la ciudad más cercana al abrir la app."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "de12ca56-0757-4a48-93c5-2c2698b43b4f"
      }
    },
    "owner": "elenaaaamavaz"
  }
}
