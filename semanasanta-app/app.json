{
  "expo": {
    "name": "semanasanta-app",
    "slug": "semanasanta-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elenaaaamavaz.semanasantaapp",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "virtual.lab.inf.uva.es": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#120A06",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "package": "com.elenaaaamavaz.semanasantaapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#120A06"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para seleccionar automáticamente la ciudad más cercana y, si eres cofrade, para compartir el avance de tu procesión.",
          "locationAlwaysAndWhenInUsePermission": "Si eres cofrade, tu ubicación se comparte durante la procesión aunque bloquees el móvil, para que los ciudadanos puedan seguirla en el mapa.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos la cámara para leer el código QR de acceso de tu cofradía.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "de12ca56-0757-4a48-93c5-2c2698b43b4f"
      }
    },
    "owner": "elenaaaamavaz"
  }
}
